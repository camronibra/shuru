[Unit]
Description=shuru: database snapshot
Documentation=file:///opt/shuru/docs/architecture.md
After=network-online.target
Wants=network-online.target
OnFailure=lab-alert@%n.service

[Service]
Type=oneshot
User=shuru
Group=shuru
WorkingDirectory=/opt/shuru
Environment=LAB_ROOT=/srv/lab
Environment=LAB_SETTINGS=/opt/shuru/config/settings.toml
Environment=LAB_LOG_FORMAT=json
# NTFY_TOPIC (and anything else secret) lives here, readable by root and shuru only.
EnvironmentFile=-/etc/shuru/env
ExecStart=/opt/shuru/.venv/bin/shuru --lock-wait 3600 backup
TimeoutStartSec=1h

# --- Resource limits: this host may also run services that must not be starved ---
Nice=19
IOSchedulingClass=idle
CPUQuota=40%
MemoryHigh=200M
MemoryMax=300M
MemorySwapMax=0
TasksMax=64

# --- Sandbox: scraped content is hostile input, so assume the process can be subverted ---
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/lab/db /srv/lab/backups
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=yes
UMask=0027
