# Copy to .env for local use. Never commit .env.
# The CLI reads .env from the current directory. Real environment variables win.

# Data root (database, models, exports). Default: ~/.local/share/shuru
# LAB_ROOT=/srv/lab

# Settings file. sources.toml, news_feeds.toml and markers.toml are read from its folder.
# LAB_SETTINGS=./config/settings.toml

# LAB_LOG_LEVEL=DEBUG
# LAB_LOG_FORMAT=json

# Phone alerts through ntfy. Without a topic, alerts are only logged.
# Treat the topic like a password: anyone who knows it can read your alerts.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
